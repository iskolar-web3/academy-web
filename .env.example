# Committed config contract (holds no secrets). Copy to .env for local dev.

# academy-server base URL (its PORT defaults to 5000).
VITE_BACKEND_URL=http://localhost:5000

# Temporary Google Auth. The client secret belongs only in academy-server/.env.
VITE_GOOGLE_AUTH_ENABLED=true
VITE_GOOGLE_AUTH_URL=http://localhost:5000/auth/google

# Real iSkolar-main hosted SSO login URL. academy-server does NOT host a login page —
# it only verifies the auth_token cookie. Leave empty in dev and mint a token instead
# (academy-server: pnpm exec tsx src/dev/mint-token.ts <userId> <role>).
VITE_ISKOLAR_SSO_URL=
